# wiki-agent 后端配置（复制为 .env 后填写；.env 已 gitignore，禁止提交）
# 决策依据见 .doc/plan.md §0 决策 5 / 5a

# ── LLM（对话模型，走 OpenAI 兼容协议）────────────────────────
# 千问 AI 平台: https://cn-beijing.maas.qianwenaiapi.com/compatible-mode/v1  model: qwen3.8-flash / qwen3.8-max
# DeepSeek: https://api.deepseek.com/v1        model: deepseek-chat
# 通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1   model: qwen-plus
# Moonshot: https://api.moonshot.cn/v1         model: moonshot-v1-8k
LLM_API_KEY=sk-xxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=qwen3.8-flash
LLM_TEMPERATURE=0
# 前端可切换的候选模型（白名单，逗号分隔）
LLM_MODELS=qwen3.8-flash,qwen3.8-max
# 千问平台 qwen3.8 系列默认带 reasoning_content，关掉可省延迟
LLM_ENABLE_THINKING=false

# ── Embedding（决策 5a：必须显式配置，Chroma 默认是英文模型，中文实测不可用）──
# 可与 LLM 不同厂商；DeepSeek 无 embedding，需另配下面两家之一：
# DashScope:    https://dashscope.aliyuncs.com/compatible-mode/v1  model: text-embedding-v4
# SiliconFlow:  https://api.siliconflow.cn/v1                      model: BAAI/bge-m3
EMBEDDING_API_KEY=sk-xxxx
EMBEDDING_BASE_URL=https://cn-beijing.maas.qianwenaiapi.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4   # 实测 4/4 中文命中；平台另有 qwen3.7-text-embedding / -flash

# ── 多 Provider（可选，前端下拉切换用）──────────────────────
# 填了 LLM_PROVIDERS 就以它为准；留空则自动把上面的 LLM_* 折叠成单个 provider。
# supports_thinking=false 的 provider 不会收到 enable_thinking（智谱不认这个参数）。
# 模板（压成一行填）：
# LLM_PROVIDERS=[{"id":"qwen","label":"千问 AI 平台","base_url":"https://...","api_key":"sk-...","models":["qwen3.8-flash","qwen3.8-max"],"supports_thinking":true},{"id":"glm","label":"智谱 GLM","base_url":"https://open.bigmodel.cn/api/paas/v4","api_key":"...","models":["glm-4-flash"],"supports_thinking":false}]
LLM_PROVIDERS=

# ── 向量库 / 语料 ────────────────────────────────────────────
CHROMA_PATH=../data/chroma
PDF_DIR=../data/pdfs
WIKI_DIR=../data/wiki
RETRIEVAL_K=4
WIKI_SIM_THRESHOLD=0.68

# ── Agent 行为（V2/V3）──────────────────────────────────────
MAX_REWRITES=2
